---
import { getImage } from "astro:assets";
import Footer from "../components/Footer.astro";
import About from "../components/home/About.astro";
import Career from "../components/home/Career.astro";
import Hero from "../components/home/Hero.astro";
import Links from "../components/home/Links.astro";
import Research from "../components/home/Research.astro";
import Wave from "../components/Wave.astro";
import { AUTHOR, SITE_URL, SOCIAL_LINKS } from "../data/site";
import profile from "../images/profile.jpg";
import Base from "../layouts/Base.astro";

// OG 画像はクローラー互換性のため jpeg で自サイトから配信する
const ogImage = await getImage({ src: profile, width: 1200, format: "jpeg" });
const ogImageUrl = new URL(ogImage.src, SITE_URL).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.name,
  alternateName: AUTHOR.nameJa,
  url: `${SITE_URL}/`,
  image: ogImageUrl,
  sameAs: SOCIAL_LINKS.map((link) => link.href),
};
---

<Base
  title="Portfolio"
  ogTitle="mizuki's Portfolio"
  description={`mizuki's Portfolio | ${AUTHOR.nameJa}のポートフォリオページ`}
  ogImage={ogImageUrl}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>
  <main>
    <Hero />
    <Wave from="dark" to="light" />
    <About />
    <Wave from="light" to="dark" />
    <Career />
    <Wave from="dark" to="light" />
    <Research />
    <Wave from="light" to="dark" />
    <Links />
  </main>
  <Footer />
</Base>
