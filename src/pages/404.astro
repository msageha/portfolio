---
import Page from "../layouts/Page.astro";
---

<Page title="Not found" description="Page not found" noindex>
  <div lang="en" class="mx-auto max-w-4xl">
    <h1 class="mb-16 text-4xl font-bold">Page not found</h1>
    <p class="mb-10 text-gray-300">Sorry 😔, we couldn’t find what you were looking for.</p>
    <a
      href="/"
      class="inline-flex rounded-full bg-linear-to-r from-pink-600 to-violet-600 px-6 py-3 font-semibold text-white transition-opacity hover:opacity-90 forced-colors:underline"
    >
      Go home
    </a>
  </div>
</Page>
