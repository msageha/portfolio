---
import Page from "../layouts/Page.astro";
---

<Page title="Not found" description="Page not found" noindex>
  <div class="mx-auto max-w-4xl">
    <h1 class="mb-16 text-4xl font-bold">Page not found</h1>
    <p class="mb-12">
      Sorry 😔, we couldn’t find what you were looking for.
      <br />
      <br />
      <a href="/" class="text-pink-400 underline hover:text-pink-300"
      >Go home</a>.
    </p>
  </div>
</Page>
