---
import BlogIndex from "../../../components/blog/BlogIndex.astro";
import { BLOG, SITE_URL } from "../../../data/site";
import Page from "../../../layouts/Page.astro";
import { collectTags, getSortedPosts } from "../../../lib/posts";

const { tag, tags, posts } = Astro.props;

export async function getStaticPaths() {
  const allPosts = await getSortedPosts();
  const allTags = collectTags(allPosts);
  return allTags.map((name) => ({
    params: { tag: name },
    props: {
      tag: name,
      tags: allTags,
      posts: allPosts.filter((post) => post.data.tags.includes(name)),
    },
  }));
}
---

<Page
  title={`${tag} の記事一覧 | ${BLOG.title}`}
  ogTitle={`${tag} の記事一覧`}
  description={`「${tag}」タグの記事一覧（${posts.length} 件）。${BLOG.description}。`}
  ogImage={{ url: new URL("/og/blog.png", SITE_URL).href, alt: BLOG.title }}
>
  <BlogIndex posts={posts} tags={tags} activeTag={tag} />
</Page>
