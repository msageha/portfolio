---
import BlogIndex from "../../../components/blog/BlogIndex.astro";
import { BLOG, SITE_URL } from "../../../data/site";
import Page from "../../../layouts/Page.astro";
import { collectTags, getSortedPosts } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = collectTags(posts);
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      tags,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

const { tag, tags, posts } = Astro.props;
---

<Page
  title={`${tag} の記事一覧 | ${BLOG.title}`}
  ogTitle={`${tag} の記事一覧`}
  description={`「${tag}」タグの記事一覧（${posts.length} 件）。${BLOG.description}。`}
  ogImage={new URL("/og/blog.png", SITE_URL).href}
>
  <BlogIndex posts={posts} tags={tags} activeTag={tag} />
</Page>
