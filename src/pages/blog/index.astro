---
import BlogIndex from "../../components/blog/BlogIndex.astro";
import { AUTHOR, BLOG, SITE_URL } from "../../data/site";
import Page from "../../layouts/Page.astro";
import { collectTags, getSortedPosts } from "../../lib/posts";

const posts = await getSortedPosts();
---

<Page
  title={`Blog | ${AUTHOR.name} - Portfolio`}
  ogTitle={`Blog | ${AUTHOR.name}`}
  description={BLOG.description}
  ogImage={new URL("/og/blog.png", SITE_URL).href}
>
  <BlogIndex posts={posts} tags={collectTags(posts)} />
</Page>
