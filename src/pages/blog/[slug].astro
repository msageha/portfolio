---
import { render } from "astro:content";
import BackToTop from "../../components/blog/BackToTop.astro";
import ShareButtons from "../../components/blog/ShareButtons.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import { AUTHOR, BLOG, SITE_URL } from "../../data/site";
import Page from "../../layouts/Page.astro";
import {
  formatDate,
  getSortedPosts,
  lastModified,
  postPath,
  tagPath,
  toIsoDate,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, tags, description } = post.data;

const postUrl = new URL(postPath(post), SITE_URL).href;
const ogImage = new URL(`/og/${post.data.slug}.png`, SITE_URL).href;
const published = toIsoDate(date);
const modified = toIsoDate(lastModified(post));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  url: postUrl,
  mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
  image: ogImage,
  datePublished: published,
  dateModified: modified,
  author: { "@type": "Person", name: AUTHOR.name, url: `${SITE_URL}/` },
  description,
};
---

<Page
  title={`${title} | ${BLOG.title}`}
  ogTitle={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <meta property="article:modified_time" content={modified} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>

  <div class="mx-auto max-w-6xl">
    <div class="fade-in" style="animation-delay: 300ms">
      <a
        href="/blog/"
        class="inline-block mb-8 text-pink-400 transition-colors hover:text-pink-300"
      >
        ← ブログ一覧に戻る
      </a>
    </div>

    <div class="lg:flex lg:items-start lg:gap-10">
      <TableOfContents headings={headings} />

      <article class="min-w-0 flex-1" data-pagefind-body>
        <header class="fade-in mb-12" style="animation-delay: 500ms">
          <h1 class="text-gradient mb-6 text-4xl font-extrabold md:text-5xl">
            {title}
          </h1>
          <div
            class="flex flex-wrap items-center gap-4 text-gray-400"
            data-pagefind-ignore
          >
            <time datetime={published}>{formatDate(date)}</time>
            {tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a
                    href={tagPath(tag)}
                    class="rounded-full border border-gray-700 bg-gray-800 px-3 py-1 text-sm transition-colors hover:border-gray-500 hover:bg-gray-700"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </div>
        </header>

        <div class="post-body fade-in" style="animation-delay: 700ms">
          <Content />
        </div>

        <footer
          class="fade-in mt-16 border-t border-gray-800 pt-8"
          style="animation-delay: 900ms"
        >
          <ShareButtons title={title} url={postUrl} />
          <a
            href="/blog/"
            class="inline-block text-pink-400 transition-colors hover:text-pink-300"
          >
            ← ブログ一覧に戻る
          </a>
        </footer>
      </article>
    </div>
  </div>
  <BackToTop />
</Page>
