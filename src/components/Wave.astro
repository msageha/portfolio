---
// 隣接するセクションの境界に置く波形。上の色を背景に、下の色の波を重ねる
import { TONES, type Tone } from "./tone";

interface Props {
  from: Tone;
  to: Tone;
}

const { from, to } = Astro.props;

// 波形の座標系: 幅 150 の区間 (x = 0〜150, y = 24〜52) を表示枠いっぱいに伸ばして見せる。
// 波形の path は x = -160〜192 にあり、x 方向に 48 ずらした位置を中心に -90〜+85 の範囲で揺らす
const VIEW = { x: 0, y: 24, width: 150, height: 28 };
const PATH = { x: -160, width: 352, offsetX: 48 };
const DRIFT = { from: -90, to: 85 };
const WAVE_PATH = "M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z";
const LAYERS = [
  { y: 0, opacity: 0.5, duration: "9s", delay: "-2s" },
  { y: 3, opacity: 0.3, duration: "12s", delay: "-3s" },
  { y: 5, opacity: 0.15, duration: "15s", delay: "-4s" },
  { y: 7, opacity: 1, duration: "22s", delay: "-5s" },
];

const percent = (value: number, base: number) => `${(value / base) * 100}%`;

// SVG の要素 (<svg> 自体を含む) の transform アニメーションは Chrome では compositor で処理されず、
// 毎フレーム style の再計算と描画が走る。層ごとに path 全体を覆う <div> を置いてその <div> を動かす。
// 揺れ幅は <div> 自身の幅 (path の幅) に対する割合で指定する
const layerBox = [
  `left: ${percent(PATH.x + PATH.offsetX - VIEW.x, VIEW.width)}`,
  `width: ${percent(PATH.width, VIEW.width)}`,
  `--wave-from: ${percent(DRIFT.from, PATH.width)}`,
  `--wave-to: ${percent(DRIFT.to, PATH.width)}`,
].join("; ");
---

<div class:list={["relative h-[15vh] min-h-[100px] w-full overflow-hidden", TONES[from].bg]}>
  {LAYERS.map((layer) => (
    <div
      class:list={["wave-layer absolute top-0 h-full", TONES[to].wave]}
      style={`${layerBox}; animation-duration: ${layer.duration}; animation-delay: ${layer.delay}`}
    >
      <svg
        class="block h-full w-full"
        xmlns="http://www.w3.org/2000/svg"
        viewBox={`${PATH.x} ${VIEW.y - layer.y} ${PATH.width} ${VIEW.height}`}
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d={WAVE_PATH} fill="currentColor" fill-opacity={layer.opacity} />
      </svg>
    </div>
  ))}
</div>
