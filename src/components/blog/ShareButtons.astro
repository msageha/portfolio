---
import Icon from "../Icon.astro";

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const text = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);

const targets = [
  {
    label: "ポスト",
    href: `https://twitter.com/intent/tweet?text=${text}&url=${encodedUrl}`,
    icon: "x",
  },
  {
    label: "はてなブックマーク",
    href: `https://b.hatena.ne.jp/entry/panel/?url=${encodedUrl}`,
    icon: "hatena",
  },
  {
    label: "Facebook でシェア",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: "facebook",
  },
  {
    label: "LinkedIn でシェア",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: "linkedin",
  },
] as const;
---

<div class="mb-8 flex flex-wrap items-center gap-3">
  <span class="text-sm text-gray-400">この記事をシェアする:</span>
  {targets.map((target) => (
    <a
      href={target.href}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 rounded-full border border-gray-700 bg-gray-800 px-4 py-2 text-sm transition-colors hover:border-gray-500 hover:bg-gray-700"
    >
      {target.icon === "hatena"
        ? (
          <span
            class="flex h-4 w-4 items-center justify-center rounded-sm bg-[#00A4DE] text-[10px] leading-none font-extrabold text-white"
            aria-hidden="true"
          >
            B!
          </span>
        )
        : <Icon name={target.icon} size={16} />}
      {target.label}
    </a>
  ))}
</div>
