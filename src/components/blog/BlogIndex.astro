---
import { BLOG } from "../../data/site";
import { type Post, tagPath } from "../../lib/posts";
import Reveal from "../Reveal.astro";
import PostCard from "./PostCard.astro";
import Search from "./Search";

interface Props {
  posts: Post[];
  tags: string[];
  activeTag?: string;
}

const { posts, tags, activeTag } = Astro.props;

const filters = [
  { label: "すべて", href: "/blog/", active: activeTag === undefined },
  ...tags.map((tag) => ({
    label: tag,
    href: tagPath(tag),
    active: tag === activeTag,
  })),
];
---

<Reveal delay={300}>
  <div class="mb-16 text-center">
    <h1 class="mb-4 text-4xl font-extrabold md:text-6xl lg:text-7xl">
      <span class="text-gradient">{activeTag ? `#${activeTag}` : "Blog"}</span>
    </h1>
    <p class="text-lg text-gray-400 md:text-xl">
      {activeTag ? `${posts.length} 件の記事` : BLOG.description}
    </p>
  </div>
</Reveal>

<div class="mx-auto mb-8 max-w-xl">
  <Search client:idle />
</div>

<Reveal delay={600}>
  <nav
    aria-label="タグで絞り込む"
    class="mb-12 flex flex-wrap justify-center gap-2"
  >
    {filters.map((filter) => (
      <a
        href={filter.href}
        aria-current={filter.active ? "page" : undefined}
        class:list={[
          "rounded-full px-4 py-2 text-sm transition-all",
          filter.active
            ? "bg-linear-to-r from-pink-500 to-violet-500 text-white"
            : "bg-gray-800 text-gray-300 hover:bg-gray-700",
        ]}
      >
        {filter.label}
      </a>
    ))}
  </nav>
</Reveal>

<div class="mx-auto grid max-w-4xl gap-6">
  {posts.map((post, index) => (
    <Reveal delay={Math.min(index, 5) * 100}>
      <PostCard post={post} />
    </Reveal>
  ))}
</div>
