---
import Reveal from "./Reveal.astro";

interface Props {
  id: string;
  title: string;
  tone: "dark" | "light";
  class?: string;
}

const { id, title, tone, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={[
    tone === "dark" ? "bg-gray-900 text-white" : "bg-slate-300 text-black",
    className,
  ]}
>
  <Reveal delay={300}>
    <h2
      id={`${id}-title`}
      class="mb-10 text-center text-3xl font-bold md:text-5xl lg:text-6xl"
    >
      {title}
    </h2>
  </Reveal>
  <slot />
</section>
