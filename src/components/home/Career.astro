---
import { ACTIVITIES, CAREER } from "../../data/career";
import Reveal from "../Reveal.astro";
import Section from "./Section.astro";
import SectionSubtitle from "./SectionSubtitle.astro";

const groups = [
  { title: "経歴", entries: CAREER },
  { title: "インターン / 業務委託 / その他", entries: ACTIVITIES },
];
---

<Section
  id="career"
  title="Career"
  tone="dark"
  class="pb-8 text-center text-sm md:text-base lg:text-lg"
>
  {groups.map((group, index) => (
    <Reveal delay={600} class={index > 0 ? "mt-12" : undefined}>
      <SectionSubtitle title={group.title} />
      <dl class="mx-auto max-w-2xl px-6 text-left">
        {group.entries.map((entry) => (
          <div class="relative grid grid-cols-1 gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-4 border-l border-gray-700 py-3 pl-6 before:absolute before:top-[17px] before:-left-[5px] before:h-2.5 before:w-2.5 before:rounded-full before:bg-linear-to-r before:from-pink-500 before:to-violet-500 md:grid-cols-[11rem_1fr] md:before:top-[19px] lg:grid-cols-[12rem_1fr] lg:before:top-[21px]">
            <dt class="text-gray-400 tabular-nums">{entry.period}</dt>
            <dd class="font-medium">
              {entry.href ? (
                <a
                  href={entry.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-pink-500/40 underline-offset-4 transition-colors hover:text-pink-300 hover:decoration-pink-400"
                >
                  {entry.name}
                </a>
              ) : (
                entry.name
              )}
            </dd>
          </div>
        ))}
      </dl>
    </Reveal>
  ))}
</Section>
