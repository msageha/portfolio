---
import { PAPERS, PATENTS } from "../../data/publications";
import Reveal from "../Reveal.astro";
import { REVEAL_DELAY_MS } from "../revealDelay";
import AuthorList from "./AuthorList.astro";
import Section from "./Section.astro";
import SectionSubtitle from "./SectionSubtitle.astro";
---

<Section id="publish" title="成果" tone="light">
  <Reveal delay={REVEAL_DELAY_MS.content} class="mx-4 md:mx-8">
    <SectionSubtitle title="特許" />
    <div class="flex justify-center">
      <div class="grid w-full max-w-3xl gap-4 text-sm md:text-base lg:text-lg">
        {PATENTS.map((patent) => (
          <div>
            <a
              class="block rounded-xl bg-white/50 p-5 text-black ring-1 ring-slate-400/30 transition-colors hover:bg-white/80 hover:ring-pink-500/40 forced-colors:hover:underline"
              href={patent.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <h4 class="font-semibold">{patent.title}</h4>
              <div class="mt-1 text-slate-700">{patent.assignee}</div>
              <div class="text-slate-700">
                <AuthorList names={patent.inventors} />
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </Reveal>
  <Reveal delay={REVEAL_DELAY_MS.content} class="mx-4 mt-12 pb-8 md:mx-8">
    <SectionSubtitle title="執筆論文" />
    <div class="flex justify-center">
      <div class="grid w-full max-w-3xl gap-4 text-sm md:text-base lg:text-lg">
        {PAPERS.map((paper) => (
          <div class="rounded-xl bg-white/50 p-5 ring-1 ring-slate-400/30">
            <h4 class="font-semibold">{paper.title}</h4>
            <div class="mt-1 text-slate-700">
              <AuthorList names={paper.authors} />
            </div>
            <div class="mt-1 text-slate-600">{paper.venue}</div>
          </div>
        ))}
      </div>
    </div>
  </Reveal>
</Section>
