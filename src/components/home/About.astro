---
import { Picture } from "astro:assets";

import { AUTHOR, PROFILE_PHOTO_ALT } from "../../data/site";
import profile from "../../images/profile.jpg";
import Reveal from "../Reveal.astro";
import { REVEAL_DELAY_MS } from "../revealDelay";
import Section from "./Section.astro";

// プロフィール写真の幅 (px)。高解像度の画面向けの大きさで、狭い画面向けにその半分の幅も作る
const PROFILE_PHOTO_WIDTH = 800;

const TECH_STACK = [
  "言語: Python, Golang, Typescript, Dart(Flutter)",
  "データベース: MySQL, PostgreSQL, BigQuery, Redis, Elasticsearch",
  "クラウド: AWS, GCP",
  "コンテナ: Docker, Kubernetes",
  "分散処理: Apache Beam, Apache Spark",
  "その他: Apache Airflow, Terraform, Git, CircleCI",
];
---

<Section id="about" title="About me" tone="light">
  <Reveal delay={REVEAL_DELAY_MS.content} class="mx-8">
    <div
      class="mx-auto max-w-6xl text-black md:flex md:flex-row md:items-center md:justify-center md:gap-12 lg:gap-16"
    >
      <figure class="md:w-2/5 lg:w-1/3">
        <Picture
          src={profile}
          width={PROFILE_PHOTO_WIDTH}
          widths={[PROFILE_PHOTO_WIDTH / 2, PROFILE_PHOTO_WIDTH]}
          sizes="(min-width: 1216px) 384px, (min-width: 1024px) calc((100vw - 4rem) / 3), (min-width: 768px) calc((100vw - 4rem) * 0.4), calc(100vw - 4rem)"
          formats={["avif", "webp"]}
          alt={PROFILE_PHOTO_ALT}
          class="h-auto w-full rounded-2xl shadow-xl shadow-slate-900/20"
        />
        <figcaption class="mt-2 text-xs text-slate-600 md:text-sm">
          ※台湾 九份で撮影したもの
        </figcaption>
      </figure>
      <dl
        class="mt-8 divide-y divide-slate-400/40 text-sm md:mt-0 md:w-1/2 md:text-base lg:text-lg"
      >
        <div class="flex gap-4 py-3">
          <dt class="w-1/4 shrink-0 font-semibold text-slate-700">氏名</dt>
          <dd class="flex-1">{AUTHOR.nameJa} (さんご みずき)</dd>
        </div>
        <div class="flex gap-4 py-3">
          <dt class="w-1/4 shrink-0 font-semibold text-slate-700">生年月日</dt>
          <dd class="flex-1">1994年 6月 22日</dd>
        </div>
        <div class="flex gap-4 py-3">
          <dt class="w-1/4 shrink-0 font-semibold text-slate-700">mail</dt>
          <dd class="flex-1">
            <a
              class="text-black underline decoration-pink-500/50 underline-offset-4 transition-colors hover:decoration-pink-500"
              href="mailto:msageha+info@gmail.com"
            >
              msageha+info -at- gmail.com
            </a>
          </dd>
        </div>
        <div class="flex gap-4 py-3">
          <dt class="w-1/4 shrink-0 font-semibold text-slate-700">趣味、嗜好</dt>
          <dd class="flex-1">
            オンラインゲーム、旅行。
            <br>
            海外は20ヶ国以上。
            <br>
            フランス ブルゴーニュ地方のワインが好き。
          </dd>
        </div>
        <div class="flex gap-4 py-3">
          <dt class="w-1/4 shrink-0 font-semibold text-slate-700">
            技術スタック
            <br>
            (業務経験
            <br>
            1年以上)
          </dt>
          <dd class="flex-1">
            {TECH_STACK.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </dd>
        </div>
      </dl>
    </div>
  </Reveal>
</Section>
