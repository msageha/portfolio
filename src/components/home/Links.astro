---
import { SOCIAL_LINKS, WEBTOOLS_URL } from "../../data/site";
import Icon from "../Icon.astro";
import Reveal from "../Reveal.astro";
import { REVEAL_DELAY_MS } from "../revealDelay";
import Section from "./Section.astro";

const links = [
  ...SOCIAL_LINKS.map((link) => ({ ...link, external: true })),
  { label: "Blog", href: "/blog/", icon: "blog", external: false },
  { label: "webtools", href: WEBTOOLS_URL, icon: "gear", external: true },
] as const;
---

<Section id="links" title="Links" tone="dark">
  <Reveal delay={REVEAL_DELAY_MS.content}>
    <div
      class="mx-auto grid max-w-3xl grid-cols-3 justify-items-center gap-y-8 px-4 sm:grid-cols-6"
    >
      {links.map((link) => (
        <a
          href={link.href}
          class="group flex flex-col items-center gap-2 text-gray-200 transition-colors hover:text-pink-300"
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
        >
          <span class="transition-transform duration-200 group-hover:-translate-y-1">
            <Icon name={link.icon} size={56} />
          </span>
          <span class="text-sm md:text-base">{link.label}</span>
        </a>
      ))}
    </div>
  </Reveal>
</Section>
