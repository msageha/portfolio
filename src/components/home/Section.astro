---
import Reveal from "../Reveal.astro";
import { REVEAL_DELAY_MS } from "../revealDelay";
import { TONES, type Tone } from "./tone";

interface Props {
  id: string;
  title: string;
  tone: Tone;
  class?: string;
}

const { id, title, tone, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={[TONES[tone].bg, TONES[tone].text, className]}
>
  <Reveal delay={REVEAL_DELAY_MS.heading}>
    <h2 id={`${id}-title`} class="mb-10 text-center text-3xl font-bold md:text-5xl lg:text-6xl">
      {title}
    </h2>
  </Reveal>
  <slot />
</section>
