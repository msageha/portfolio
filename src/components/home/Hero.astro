---
import { AUTHOR } from "../../data/site";
import Reveal from "../Reveal.astro";
import { REVEAL_DELAY_MS } from "../revealDelay";
---

{/* 固定ヘッダーの分を上に空け、低い画面では中身に合わせて伸ばす */}
<section id="hero" class="flex min-h-screen flex-col bg-gray-900 pt-header">
  <div class="mx-10 flex flex-1 flex-col items-center justify-center py-8 text-center">
    <Reveal delay={REVEAL_DELAY_MS.heading}>
      <h1 lang="en" class="mb-8 text-4xl font-extrabold text-white md:text-6xl lg:text-7xl">
        This is a portfolio about
        <br>
        <span class="text-gradient">{AUTHOR.name}</span>
      </h1>
    </Reveal>
    <Reveal delay={REVEAL_DELAY_MS.callToAction}>
      <a
        href="#about"
        lang="en"
        class="group inline-flex items-center gap-2 rounded-full border border-pink-500/40 px-6 py-3 text-lg font-semibold text-pink-300 transition-colors hover:border-pink-400 hover:bg-pink-500/10 hover:text-pink-200 md:text-2xl"
      >
        About me
        <svg
          class="h-5 w-5 transition-transform group-hover:translate-y-0.5 md:h-6 md:w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </Reveal>
  </div>
</section>
