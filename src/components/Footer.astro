---
import { AUTHOR, GITHUB_URL } from "../data/site";
---

<footer
  class="border-t border-gray-800 bg-gray-900 px-4 pt-10 pb-8 text-center text-sm text-gray-400"
>
  Copyright © {new Date().getFullYear()} - Developed by{" "}
  <a
    href={GITHUB_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="text-gray-200 transition-colors hover:text-pink-300"
  >
    {AUTHOR.name}
  </a>
</footer>
